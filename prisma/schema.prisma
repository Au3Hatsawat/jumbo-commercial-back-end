generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. User / Customer Management
// ==========================================

model Customer {
  id          Int      @id @default(autoincrement())
  name        String?
  phoneNumber String   @unique 
  points      Int      @default(0) 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orders      Order[]
  factSales   FactSale[]

  @@map("customers")
}

// ==========================================
// 2. Product & Stock Management
// ==========================================

model Category {
  id        Int      @id @default(autoincrement())
  nameTh    String   @unique
  nameEn    String   @unique

  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  factSales FactSale[]

  @@map("categories")
}

model Unit {
  id        Int      @id @default(autoincrement())
  nameTh    String   @unique
  nameEn    String   @unique

  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[] 
  
  sellingUnits ProductSellingUnit[]

  @@map("units")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String   
  description  String?
  imageUrl     String?

  // --- Foreign Keys ---
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])

  baseUnitId   Int     
  baseUnit     Unit     @relation(fields: [baseUnitId], references: [id])
  
  averageCost  Decimal  @default(0) @db.Decimal(10, 7) 
  currentStock Int      @default(0) 
  vatRate      Decimal  @default(7.00) @db.Decimal(5, 2)

  isDeleted    Boolean  @default(false)
  deletedAt    DateTime? 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Relations ---
  sellingUnits ProductSellingUnit[] 
  stockLogs    StockLog[]
  orderItems   OrderItem[]
  factSales    FactSale[]

  @@map("products")
}

model ProductSellingUnit {
  id           Int      @id @default(autoincrement())
  imageUrl     String?
  
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  barcode      String   @unique 
  
  unitId       Int      
  unit         Unit     @relation(fields: [unitId], references: [id])
  
  multiplier   Int      @default(1) 
  
  price        Decimal  @db.Decimal(10, 7) 
  sellType     SellType @default(RETAIL)   

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems   OrderItem[] 

  @@map("product_selling_units")
}

model StockLog {
  id        Int       @id @default(autoincrement())
  
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  
  quantity  Int       
  type      StockType 
  
  costPrice Decimal?  @db.Decimal(10, 7) 
  note      String?   
  createdAt DateTime  @default(now())

  @@map("stock_logs")
}

enum SellType {
  RETAIL
  WHOLESALE
}

enum StockType {
  RESTOCK
  SALE
  ADJUSTMENT
  DAMAGED
  RETURN
}

// ==========================================
// 3. Order / Transaction (Operational)
// ==========================================

model Order {
  id            Int         @id @default(autoincrement())
  orderNo       String      @unique
  
  customerId    Int?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  
  totalAmount   Decimal     @db.Decimal(10, 7)
  paymentMethod String?     
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  items         OrderItem[]
  factSales     FactSale[]

  @@map("orders")
}

model OrderItem {
  id                 Int      @id @default(autoincrement())
  
  orderId            Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId          Int
  product            Product  @relation(fields: [productId], references: [id])
  
  sellingUnitId      Int?
  sellingUnit        ProductSellingUnit? @relation(fields: [sellingUnitId], references: [id], onDelete: SetNull)

  productName        String   
  unitName           String
  unitNameEn         String? 
  imageUrl           String?  
  sellType           SellType @default(RETAIL)
  
  quantity           Int      

  vatRate      Decimal  @default(7.00) @db.Decimal(5, 2)
  
  priceAtSale        Decimal  @db.Decimal(10, 7) 
  costAtSale         Decimal  @db.Decimal(10, 7) 
  multiplierAtSale   Int      @default(1)       
  
  @@map("order_items")
}

// ==========================================
// 4. Analytics / Data Warehouse (Fact Tables)
// ==========================================

model FactSale {
  id               BigInt   @id @default(autoincrement()) 
  
  // --- Dimensions ---
  orderId          Int
  order            Order    @relation(fields: [orderId], references: [id])
  
  productId        Int
  product          Product  @relation(fields: [productId], references: [id])
  
  categoryId       Int
  category         Category @relation(fields: [categoryId], references: [id])
  
  customerId       Int?     
  customer         Customer? @relation(fields: [customerId], references: [id])

  // --- Time Dimension ---
  dateKey          DateTime @db.Date 
  timeKey          DateTime 
  
  // --- Measures ---
  sellType         SellType 
  
  quantity         Int      
  baseUnitQuantity Int      
  totalPrice       Decimal  @db.Decimal(12, 7) 
  totalCost        Decimal  @db.Decimal(12, 7) 
  profit           Decimal  @db.Decimal(12, 7) 

  createdAt        DateTime @default(now())

  @@index([dateKey])
  @@index([productId])
  @@index([categoryId])
  @@map("fact_sales")
}

model FactDailySummary {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date 
  
  totalOrders Int      @default(0)
  totalSales  Decimal  @default(0) @db.Decimal(12, 7)
  totalCost   Decimal  @default(0) @db.Decimal(12, 7)
  totalProfit Decimal  @default(0) @db.Decimal(12, 7)
  
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("fact_daily_summaries")
}